@PACKAGE_INIT@
if(@ABSTRACTION_FACADE_BUILD_AGGREGATE@ OR @ABSTRACTION_FACADE_BUILD_JOBS@)
    include(CMakeFindDependencyMacro)
    find_dependency(abstraction_job_acceptance CONFIG)
    find_dependency(abstraction_ipc CONFIG)
endif()
if(@ABSTRACTION_FACADE_BUILD_AGGREGATE@)
    include(CMakeFindDependencyMacro)
    find_dependency(abstraction_logging CONFIG)
    find_dependency(abstraction_config CONFIG)
    find_dependency(abstraction_router CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/abstraction_facadeTargets.cmake")
